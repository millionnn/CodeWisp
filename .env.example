# 在 https://platform.deepseek.com/ 申请 DeepSeek API Key，填入下方
LLM_API_KEY=

# OpenAI 兼容接口地址（DeepSeek 默认）
LLM_BASE_URL=https://api.deepseek.com

# 常用模型：deepseek-chat（对话）或 deepseek-reasoner（推理）
LLM_MODEL=deepseek-chat

# Agent 服务的「目标仓库」根目录（可选）
# 语义：要探索/以后修改的那个项目，不是 CodeWisp 安装目录。
# 优先级：CLI --workspace > 本变量 > 启动时的当前工作目录 cwd
# 短期自测可填本仓库路径，或留空后在仓库根目录执行 python -m backend.app
CODEWISP_WORKSPACE=
