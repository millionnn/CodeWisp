# —— 方式 A：DeepSeek（默认）——
# 在 https://platform.deepseek.com/ 申请 API Key
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# —— 方式 B：硅基流动（可选第二 Provider，不改 DeepSeek 默认）——
# 保持上面 LLM_* 仍为 DeepSeek；另加：
# SILICONFLOW_API_KEY=sk-你的硅基流动密钥
# （可选）SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# CLI: /model siliconflow Qwen/Qwen3.5-4B

# Agent 服务的「目标仓库」根目录（可选）
# 语义：要探索/以后修改的那个项目，不是 CodeWisp 安装目录。
# 优先级：CLI --workspace > 本变量 > 启动时的当前工作目录 cwd
CODEWISP_WORKSPACE=
